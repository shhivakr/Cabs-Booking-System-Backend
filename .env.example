NODE_ENV=development
PORT=5000

DATABASE_URL="postgresql://postgres:<your_password>@localhost:5432/cab_crm?schema=public"

# Auth Settings
JWT_ACCESS_SECRET="<generate_secure_random_string>"
JWT_REFRESH_SECRET="<generate_secure_random_string>" # Not strictly needed if using DB hashes, but included per instruction
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"
BCRYPT_ROUNDS="12"

# Seed Settings
SUPER_ADMIN_EMAIL="admin@taxicrm.local"
SUPER_ADMIN_PASSWORD="<choose_a_secure_password>"